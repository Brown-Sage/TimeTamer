# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Database (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=time_tamer
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
# Managed hosts (Neon, RDS, ...) need TLS — uncomment for those:
# DB_SSLMODE=require

# Spotify OAuth (https://developer.spotify.com/dashboard)
# Redirect URI to whitelist: <origin>/api/spotify/callback/
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# Cross-origin API (split deployment: SPA on Vercel, API elsewhere)
# Comma-separated origins allowed to call the API with cookies:
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# CSRF_TRUSTED_ORIGINS must also include the Vercel origin and the API's own
# HTTPS origin when DEBUG=False.

# Frontend only (Vercel project env vars, NOT Django):
# VITE_API_URL=https://<api-host>
